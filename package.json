{
	"name": "deck-roulette",
	"version": "1.1.6",
	"description": "A plugin that allows you to navigate to a random game in your library or a Steam Collection.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davocarli/deck-roulette.git"
	},
	"keywords": [
		"decky",
		"plugin",
		"steam-deck",
		"deck",
		"random",
		"games",
		"steam"
	],
	"author": "Jonas Dellinger <jonas@dellinger.dev>, Chris Alves <contact@chis.dev>",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/davocarli/deck-roulette/issues"
	},
	"homepage": "https://github.com/davocarli/deck-roulette#readme",
	"devDependencies": {
		"@decky/rollup": "^1.0.2",
		"@decky/ui": "^4.11.0",
		"@types/react": "19.1.1",
		"@types/react-dom": "19.1.1",
		"@types/webpack": "^5.28.5",
		"rollup": "^4.60.1",
		"typescript": "^5.6.2"
	},
	"dependencies": {
		"@decky/api": "^1.1.3",
		"react-icons": "^5.3.0",
		"tslib": "^2.7.0"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"react",
				"react-dom"
			]
		}
	}
}
